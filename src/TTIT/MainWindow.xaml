<Window
    x:Class="TTIT.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TTIT"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Twilight Tuck-In Timer"
    Width="350"
    MinWidth="350"
    Height="Auto"
    ResizeMode="NoResize"
    d:DesignWidth="350"
    d:DesignHeight="200"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Grid Background="#363636">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Background="#2b2b2b" Height="auto" Title="Twilight Tuck-In Timer" Grid.Row="0" ApplicationTheme="Dark" CanMaximize="false" ShowClose="True" ShowMinimize="True" ShowMaximize="False" ShowHelp="True" HelpClicked="TitleBar_HelpClicked"/>

        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ui:NumberBox x:Name="HoursBox" HorizontalAlignment="Center" Grid.Column="0" Grid.Row="0" PlaceholderText="Hours" MaxLength="5" Minimum="0" Width="160"/>
            <ui:NumberBox x:Name="MinutesBox" HorizontalAlignment="Center" Grid.Column="1" Grid.Row="0" PlaceholderText="Minutes" MaxLength="5" Minimum="0" Width="160"/>


            <Separator Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,5"/>

            <ui:Button Grid.Column="0" Background="DarkOliveGreen" Grid.Row="2" HorizontalAlignment="Center" Click="OnScheduleShutdownClick" Width="160">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Clock24"/>
                    <Label Margin="5,4,0,0">Schedule Shutdown</Label>
                </StackPanel>
            </ui:Button>

            <ui:Button Grid.Column="1" Grid.Row="2"  Background="DarkRed" HorizontalAlignment="Center" Click="CancelShutdownButton_Click" Width="160">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Dismiss24"/>
                    <Label Margin="5,4,0,0">Cancel Shutdown</Label>
                </StackPanel>
            </ui:Button>


        </Grid>
    </Grid>



</Window>